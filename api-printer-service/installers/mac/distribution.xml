<?xml version="1.0" encoding="utf-8"?>
<!--
  macOS Distribution definition for productbuild.
  Controls the pages and options shown in the native Installer.app wizard.
-->
<installer-gui-script minSpecVersion="2">

    <title>API Printer Service</title>

    <!-- Custom welcome and conclusion screens (HTML files in resources/) -->
    <welcome    file="welcome.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <options
        customize="never"
        require-scripts="true"
        rootVolumeOnly="true"
        hostArchitectures="arm64 x86_64"/>

    <!-- Require macOS 11 (Big Sur) or later -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="default">
            <line choice="com.posawesome.api-printer"/>
        </line>
    </choices-outline>

    <choice id="default"/>

    <choice id="com.posawesome.api-printer"
            visible="false"
            title="API Printer Service"
            description="Installs the API Printer Service daemon.">
        <pkg-ref id="com.posawesome.api-printer"/>
    </choice>

    <!-- The component package produced by pkgbuild -->
    <pkg-ref id="com.posawesome.api-printer"
             version="1.0.0"
             onConclusion="none">api-printer-component.pkg</pkg-ref>

</installer-gui-script>
